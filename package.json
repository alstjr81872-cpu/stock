{
  "name": "novelforge-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-novelforge",
    "test:rules": "node --test tests/rules.test.mjs",
    "test:e2e:firebase": "NF_E2E_REAL_FIREBASE=1 playwright test",
    "build:cloud": "node scripts/build-cloud.mjs",
    "dev:cloud": "wrangler dev --port 8787",
    "deploy:cloud": "npm run build:cloud && wrangler deploy",
    "check:cloud": "wrangler deploy --dry-run --outdir /tmp/novelforge-worker-build",
    "test:cloud": "tsx --test tests/cloud/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tiptap/extension-placeholder": "^3.10.0",
    "@tiptap/react": "^3.10.0",
    "@tiptap/starter-kit": "^3.10.0",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "firebase": "^12.4.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@electric-sql/pglite": "^0.3.16",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "firebase-tools": "^14.22.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=24"
  }
}
