# Public Firebase web config. Copy to .env.local for local emulators only.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-novelforge.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-novelforge
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-novelforge.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
NEXT_PUBLIC_USE_EMULATORS=1
BACKEND_URL=http://127.0.0.1:8000
# Server process only: never prefix with NEXT_PUBLIC_.
# NF_MODE=emulator
# NF_AI_MODE=mock
# GCLOUD_PROJECT=demo-novelforge
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# STORAGE_EMULATOR_HOST=http://127.0.0.1:9199
# OPENROUTER_API_KEY is supplied securely to the server in live mode.
